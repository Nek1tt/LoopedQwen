{
  "seed": 42,
  "model": {
    "vocab_size": 16000,
    "hidden_size": 256,
    "intermediate_size": 768,
    "num_hidden_layers": 2,
    "num_loops": 24,
    "loop_update_mode": "normalized_projected_learned",
    "loop_update_alpha": 0.25,
    "loop_update_start_loop": 2,
