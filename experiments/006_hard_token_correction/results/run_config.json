    "loop_update_norm_eps": 1e-06,
    "loop_input_dropout": 0.0,
    "loop_input_dropout_start": 2,
    "loop_noise_std": 0.0,
    "loop_noise_mode": "relative",
    "loop_noise_start_loop": 1,
    "loop_noise_warmup_steps": 0,
    "loop_noise_after_last_loop": false,
    "num_attention_heads": 4,
    "num_key_value_heads": 2,
    "head_dim": 64,
    "max_position_embeddings": 512,
    "rope_parameters": {
      "rope_type": "default",
      "rope_theta": 10000.0
    },
    "rms_norm_eps": 1e-06,
    "attention_dropout": 0.0,
    "attention_bias": false,
    "hidden_act": "silu",
